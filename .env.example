# Public browser configuration. These values may be present in the client bundle.
VITE_PUBLIC_APP_NAME=Vishing Vaccine — development shell
VITE_API_BASE_URL=

# Local development proxy target. Not exposed to the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:3001
API_PORT=3001

# Server-only settings. Keep provider credentials out of VITE_* variables.
NODE_ENV=development
APP_VERSION=
GNANI_API_KEY=
GNANI_API_KEY_ID=
GNANI_BASE_URL=
DATABASE_URL=
SESSION_SIGNING_SECRET=
PUBLIC_DEMO_ACCESS_CODE=
CREDIT_CAP=0
PUBLIC_DEMO_CREDIT_CAP=0
RESERVE_CAP=0
# Costs are project-configured abstract units, not a Gnani billing definition.
STT_COST_UNITS=
TTS_COST_UNITS=
FEATURE_LIVE_EVON=false
ENABLE_LIVE_EVON=false

# Developer-only Prisma contract probe. Never used by /health or the browser.
# API startup and verification load the root .env; existing process values take precedence.
# Public docs are hypotheses: select endpoint/header names after reviewing participant access.
PRISMA_VERIFY_LIVE=false
PRISMA_VERIFY_WS_URL=
PRISMA_VERIFY_AUTH_HEADER=
# Choose GNANI_API_KEY or GNANI_API_KEY_ID; selected value is sent as auth, never logged.
PRISMA_VERIFY_CREDENTIAL_ENV=GNANI_API_KEY
PRISMA_VERIFY_LANGUAGE_HEADER=
PRISMA_VERIFY_LANGUAGE_CODE=
PRISMA_VERIFY_SAMPLE_RATE_HEADER=
PRISMA_VERIFY_SAMPLE_RATE_HZ=
PRISMA_VERIFY_FIXTURE_MANIFEST=
# Local candidate framing; does not establish provider requirements.
PRISMA_VERIFY_FRAME_BYTES=1024
PRISMA_VERIFY_TRAILING_PARTIAL=false
# Optional pair. Leave both unset unless deliberately testing the documented format option.
PRISMA_VERIFY_FORMAT_HEADER=
PRISMA_VERIFY_FORMAT=
# Explicit cumulative project usage before this run. Update before every intentional run.
PRISMA_VERIFY_USED_UNITS=
